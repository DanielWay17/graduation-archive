/**
 * Cloudflare Worker configuration for The Graduation Archive.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (never put them here):
 *   OWNER_PASSWORD  – the password for the owner area (/admin)
 *   SESSION_SECRET  – a long random string that signs the login cookie
 * Locally they live in `.dev.vars` (see `.dev.vars.example`).
 * In production: `npx wrangler secret put OWNER_PASSWORD` and `npx wrangler secret put SESSION_SECRET`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "graduation-archive",
	"compatibility_date": "2026-11-23",
	"main": "./workers/app.ts",
	"vars": {
		// Uploads stop once stored photos reach this size, so the R2 free tier (10 GB) is never exceeded.
		"STORAGE_LIMIT_MB": "9500",
		// How many photos one visitor (one IP address) may upload per hour.
		"GUEST_UPLOADS_PER_HOUR": "60",
		// How many photos all visitors together may upload per day.
		"GUEST_UPLOADS_PER_DAY": "1000",
		// Optional spam check (Cloudflare Turnstile). Leave empty to turn it off.
		// To turn it on, paste the site key here and run: npx wrangler secret put TURNSTILE_SECRET_KEY
		"TURNSTILE_SITE_KEY": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "graduation-archive",
			// Replace with the id printed by `npx wrangler d1 create graduation-archive` before deploying.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "graduation-archive-photos"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
