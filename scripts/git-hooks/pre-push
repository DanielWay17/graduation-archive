#!/bin/sh
# Fast local feedback: when `main` is pushed, run the type check and tests first.
# If they fail, the push is stopped. Deploying is done by GitHub Actions after the push.
# Installed by `npm run hooks:install`. Skip once with: SKIP_CHECKS=1 git push
set -e

pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    pushing_main=1
  fi
done
[ "$pushing_main" = 1 ] || exit 0
[ -n "$SKIP_CHECKS" ] && { echo "pre-push: SKIP_CHECKS is set, skipping checks."; exit 0; }

echo "pre-push: running the type check and tests…"
npm run typecheck
npm test
